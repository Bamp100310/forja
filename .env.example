# ============================================================================
# FORJA — Variables de Entorno de Ejemplo
# ============================================================================
# Copia este archivo a `.env` y reemplaza con tus valores reales de Supabase:
#
# cp .env.example .env
#
# Para obtener estos valores:
# 1. Ingresa a tu proyecto en https://supabase.com
# 2. Ve a Project Settings -> API
# 3. Copia Project URL y anon public key
# ============================================================================

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# Base path para despliegue en GitHub Pages (ej. /Contabilidad/ o /forja/)
# En desarrollo local dejar en blanco o /
VITE_BASE_PATH=/
